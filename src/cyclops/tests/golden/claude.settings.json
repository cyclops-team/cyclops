{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "/opt/cyclops/bin/cyclops hook UserPromptSubmit --agent reviewer" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "/opt/cyclops/bin/cyclops hook Stop --agent reviewer" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "/opt/cyclops/bin/cyclops hook Notification --agent reviewer" } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "/opt/cyclops/bin/cyclops hook PermissionRequest --agent reviewer" } ] }
    ]
  }
}
