#!/bin/sh
# Test-only PATH shim for the installer staging-copy fallback. It fails the
# client candidate copy and delegates every other use to the system cp.

case "${2:-}" in
    */pair.*/cyclops)
        if [ -n "${CYCLOPS_TEST_COPY_FAILURE_MARKER:-}" ]; then
            printf '%s\n' 'intentional private candidate copy failure' > \
                "$CYCLOPS_TEST_COPY_FAILURE_MARKER"
        fi
        printf '%s\n' 'intentional private candidate copy failure' >&2
        exit 1
        ;;
esac

exec /bin/cp "$@"
