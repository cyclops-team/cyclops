# Cyclops hook config template: Codex CLI hooks.json (PascalCase events).
# Rendered by `cyclops hooks install codex --agent <label>`; '#' lines are
# stripped, {label} and {cyclops_bin} are substituted.
#
# TRUST CAVEAT (finding F1, MEASURED): project-local .codex/hooks.json does
# NOT load until the working directory is trusted, and in non-interactive
# runs the trust dialog can never be answered, so hooks silently never fire.
# --dangerously-bypass-hook-trust does NOT fix this: it bypasses
# hook-definition trust, not directory trust. Working setups:
#   1. Put this file at $CODEX_HOME/hooks.json (user level loads without
#      directory trust), or
#   2. Pre-seed trust in $CODEX_HOME/config.toml:
#        [projects."<your project dir>"]
#        trust_level = "trusted"
# `cyclops hooks selftest <label>` proves the hooks actually fire.
#
# Codex loads BOTH user-level and project-level hooks when the directory is
# trusted and fires each event twice; the daemon dedupes on
# (session_id, turn_id, event), so double registration is safe but useless.
#
# Events: UserPromptSubmit is the delivery ACK (payload carries the prompt),
# Stop is turn end, PermissionRequest is the approval edge. Codex has no
# Notification event (measured available list, manifests/codex.toml).
{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "{cyclops_bin} hook UserPromptSubmit --agent {label}" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "{cyclops_bin} hook Stop --agent {label}" } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "{cyclops_bin} hook PermissionRequest --agent {label}" } ] }
    ]
  }
}
