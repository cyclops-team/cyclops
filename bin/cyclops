#!/usr/bin/env bash
# cyclops - unified entry point for the commPact toolkit.
set -euo pipefail

resolve_script_path() {
  local source="$1" dir target
  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    target="$(readlink "$source")"
    case "$target" in
      /*) source="$target" ;;
      *) source="$dir/$target" ;;
    esac
  done
  printf '%s' "$source"
}

# cyclops is typically symlinked onto PATH from the real install home
# (e.g. ~/.local/bin/cyclops -> ~/.commPact/bin/cyclops), so resolve through
# the symlink to find the sibling commPact-* commands next to it.
SCRIPT_DIR="$(cd -P "$(dirname "$(resolve_script_path "${BASH_SOURCE[0]}")")" && pwd)"
# The install root, regardless of what CYCLOPS_HOME the installer used —
# cyclops always knows where it actually lives.
INSTALL_HOME="$(cd -P "$SCRIPT_DIR/.." && pwd)"
CYCLOPS_REPO_URL="https://github.com/notyahir/cyclops.git"
# Written into every tree commPact-install produces (install and update).
# Absent from a plain source checkout, so it distinguishes a managed
# install home from the repository cyclops happens to be running out of.
MANAGED_MARKER=".commPact-installed"

die() { echo "cyclops: $*" >&2; exit 1; }

# update/uninstall are destructive against $INSTALL_HOME. Without this
# check, running `bin/cyclops update|uninstall` straight out of a source
# checkout would treat the checkout itself as the install home and fetch
# over it or rm -rf it.
require_managed_install() {
  [[ -f "$INSTALL_HOME/$MANAGED_MARKER" ]] || die "$INSTALL_HOME does not look like a managed install (missing $MANAGED_MARKER) -- refusing to $1 it. If this is a source checkout, install with 'curl -fsSL https://usecyclops.dev/install.sh | sh' instead, or use commPact-install directly."
}

usage() {
  cat <<'USAGE'
cyclops - one team, any agent

Usage: cyclops [command] [args...]

With no command, cyclops starts (or attaches to) a workspace in the current
directory. This is equivalent to `cyclops start`.

Commands:
  start [options]        Bootstrap, resume, or attach a tmux workspace
                          (team-shape options: see commPact-setup --help;
                          config-generation modes such as --dry-run,
                          --config-only, and --replace-config are
                          commPact-setup only, not accepted here)
  send TARGET ...        Send a structured message to a labeled pane
  list                   Show panes, processes, sizes, and labels
  read TARGET [LINES]    Inspect pane output
  resolve TARGET         Print the pane target for a label
  type / keys / name / message / id / doctor / hash
                          Pane-level primitives (see commPact --help)
  adopt ...               Label an existing tmux session
  layout ...               Apply the configured layout and theme
  update                  Fetch and install the latest release (no
                          options; see commPact-install for advanced use)
  uninstall                Remove this installation (no options; see
                          commPact-install for advanced use)
  version                 Print installed versions
  help                    Show this help

Examples:
  cyclops
  cyclops start --roles driver,implementer,reviewer --command codex
  cyclops send reviewer --json --subject "Review request" --body-file -
USAGE
}

has_flag() {
  local want="$1"
  shift
  local arg
  for arg in "$@"; do
    [[ "$arg" == "$want" ]] && return 0
  done
  return 1
}

# Empty means --session was never passed -- distinct from an explicit
# value -- so callers can tell "not specified" from "specified as X".
session_arg() {
  local session=""
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--session" ]]; then
      [[ $# -ge 2 ]] || die "--session requires a value"
      session="$2"
    fi
    shift
  done
  printf '%s' "$session"
}

config_arg() {
  local config_path="$INSTALL_HOME/config/team.conf"
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--config" ]]; then
      [[ $# -ge 2 ]] || die "--config requires a value"
      config_path="$2"
    fi
    shift
  done
  printf '%s' "$config_path"
}

# The session name a saved config actually targets, which may differ from
# session_arg's CLI-derived guess (e.g. it was generated with --session once
# and this invocation didn't repeat it).
config_session() {
  local config_path="$1" line
  line="$(grep -m1 '^session=' "$config_path" 2>/dev/null || true)"
  [[ -n "$line" ]] && printf '%s' "${line#session=}"
}

tmux_cmd() {
  if [[ -n "${COMMPACT_SOCKET:-}" ]]; then
    tmux -S "$COMMPACT_SOCKET" "$@"
  else
    tmux "$@"
  fi
}

attach_session() {
  if [[ -n "${COMMPACT_SOCKET:-}" ]]; then
    exec tmux -S "$COMMPACT_SOCKET" attach -t "$1"
  else
    exec tmux attach -t "$1"
  fi
}

# Decide how to bring the workspace up, given what's actually there:
# a live session wins (just attach); otherwise a saved config means the
# session was stopped (reboot, `tmux kill-session`) and should be resumed
# from it; otherwise this is a genuine first run.
start_strategy() {
  local session="$1" config_path="$2"
  if tmux_cmd has-session -t "$session" 2>/dev/null; then
    printf 'attach'
  elif [[ -e "$config_path" ]]; then
    printf 'init'
  else
    printf 'setup'
  fi
}

# Flags that only mean something when generating a new config via
# commPact-setup. If a workspace already exists (attach/init), forwarding
# these silently -- as if cyclops had applied them -- would misrepresent
# what actually happened.
reject_unusable_start_args() {
  local arg skip_next=false
  for arg in "$@"; do
    if [[ "$skip_next" == true ]]; then
      skip_next=false
      continue
    fi
    case "$arg" in
      --session | --config) skip_next=true ;;
      *) die "a workspace already exists; '$arg' only applies to first-time setup (run commPact-setup --replace-config to regenerate it, or stop the tmux session first)" ;;
    esac
  done
}

# --dry-run, --config-only, and --replace-config are commPact-setup's
# config-generation modes (print and exit, write config only, force-
# regenerate an existing config). cyclops start only ever bootstraps,
# resumes, or attaches -- keep those modes under commPact-setup directly
# instead of giving cyclops start a second, overlapping set of meanings.
reject_setup_only_flags() {
  local flag
  for flag in --dry-run --config-only --replace-config; do
    if has_flag "$flag" "$@"; then
      die "cyclops start does not support $flag; run commPact-setup directly for advanced config modes ($SCRIPT_DIR/commPact-setup --help)"
    fi
  done
}

cmd_start() {
  if has_flag --help "$@" || has_flag -h "$@"; then
    "$SCRIPT_DIR/commPact-setup" --help
    return
  fi
  reject_setup_only_flags "$@"

  local config_path
  config_path="$(config_arg "$@")"

  local config_derived_session="" explicit_session session strategy
  [[ -e "$config_path" ]] && config_derived_session="$(config_session "$config_path")"
  explicit_session="$(session_arg "$@")"
  if [[ -n "$config_derived_session" && -n "$explicit_session" && "$config_derived_session" != "$explicit_session" ]]; then
    die "the config at $config_path targets session '$config_derived_session', which conflicts with --session $explicit_session (run commPact-setup --replace-config to regenerate it, use --config to point elsewhere, or drop --session to resume '$config_derived_session')"
  fi
  session="${config_derived_session:-${explicit_session:-commpact}}"

  strategy="$(start_strategy "$session" "$config_path")"
  case "$strategy" in
    attach)
      reject_unusable_start_args "$@"
      attach_session "$session"
      ;;
    init)
      reject_unusable_start_args "$@"
      exec "$SCRIPT_DIR/commPact-init" --config "$config_path" --attach
      ;;
    setup)
      "$SCRIPT_DIR/commPact-setup" --workdir "$PWD" --attach --config "$config_path" "$@"
      ;;
  esac
}

# A function-scoped `trap ... RETURN` isn't actually scoped to the function
# that set it -- it fires on every later function return in this process,
# by which point a `local` fetch_dir is out of scope. Use one script-level
# EXIT trap instead, same as tests/regression.sh does for its temp dirs.
UPDATE_TMP_DIR=""
cleanup_update_tmp() { [[ -z "$UPDATE_TMP_DIR" ]] || rm -rf "$UPDATE_TMP_DIR"; }
trap cleanup_update_tmp EXIT

cmd_update() {
  if has_flag --help "$@" || has_flag -h "$@"; then
    "$SCRIPT_DIR/commPact-install" --help
    return
  fi
  require_managed_install update
  [[ $# -eq 0 ]] || die "cyclops update takes no options; run '$SCRIPT_DIR/commPact-install update' directly for advanced options (e.g. --replace)"
  local ref="${CYCLOPS_REF:-main}" release_dir
  UPDATE_TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/cyclops-update.XXXXXX")"

  if [[ -n "${CYCLOPS_SOURCE_DIR:-}" ]]; then
    release_dir="$CYCLOPS_SOURCE_DIR"
  else
    command -v git >/dev/null 2>&1 \
      || die "update requires git; re-run the installer instead: curl -fsSL https://usecyclops.dev/install.sh | sh"
    # Not `git clone --branch`: that flag only resolves branch and tag
    # names, so a full commit SHA (a documented CYCLOPS_REF value) would
    # fail with "Remote branch ... not found". init+fetch+checkout resolves
    # branches, tags, and (for public GitHub repos) full commit SHAs alike
    # -- same fix as frontend/static/install.sh's fetch_source.
    mkdir -p "$UPDATE_TMP_DIR/src"
    git -C "$UPDATE_TMP_DIR/src" init --quiet \
      && git -C "$UPDATE_TMP_DIR/src" fetch --quiet --depth 1 "$CYCLOPS_REPO_URL" "$ref" \
      && git -C "$UPDATE_TMP_DIR/src" checkout --quiet FETCH_HEAD \
      || die "could not fetch the latest release (ref '$ref')"
    release_dir="$UPDATE_TMP_DIR/src"
  fi

  [[ -x "$release_dir/bin/commPact-install" ]] || die "fetched release is missing bin/commPact-install"
  "$release_dir/bin/commPact-install" update --destination "$INSTALL_HOME"
}

cmd_uninstall() {
  if has_flag --help "$@" || has_flag -h "$@"; then
    "$SCRIPT_DIR/commPact-install" --help
    return
  fi
  require_managed_install uninstall
  [[ $# -eq 0 ]] || die "cyclops uninstall takes no options; run '$SCRIPT_DIR/commPact-install uninstall' directly for advanced options (e.g. --restore)"
  local invoked="${BASH_SOURCE[0]}" path_link=""
  [[ -L "$invoked" ]] && path_link="$invoked"

  "$SCRIPT_DIR/commPact-install" uninstall --destination "$INSTALL_HOME"
  [[ -z "$path_link" ]] || rm -f "$path_link"
}

main() {
  [[ $# -gt 0 ]] || set -- start

  case "$1" in
    start)
      shift
      cmd_start "$@"
      ;;
    send | list | read | resolve | type | keys | name | message | id | doctor | hash)
      local cmd="$1"
      shift
      exec "$SCRIPT_DIR/commPact" "$cmd" "$@"
      ;;
    adopt)
      shift
      exec "$SCRIPT_DIR/commPact-adopt" "$@"
      ;;
    layout)
      shift
      exec "$SCRIPT_DIR/commPact-layout" "$@"
      ;;
    update)
      shift
      cmd_update "$@"
      ;;
    uninstall)
      shift
      cmd_uninstall "$@"
      ;;
    version)
      "$SCRIPT_DIR/commPact-install" version
      "$SCRIPT_DIR/commPact" version
      ;;
    help | --help | -h)
      usage
      ;;
    *)
      die "unknown command '$1' (run 'cyclops help')"
      ;;
  esac
}

# Allow tests to `source` this file (e.g. to exercise start_strategy
# directly) without triggering the CLI dispatch below.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
