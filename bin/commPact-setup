#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=commPact-config.sh
source "$SCRIPT_DIR/../lib/commPact-config.sh"

die() { echo "commPact-setup: $*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: commPact-setup [options]

Create a new commPact session without hand-writing team.conf. The defaults are
generic examples and may be replaced with any valid labels.

Options:
  --session NAME          Session name (default: commpact)
  --workdir PATH          Pane working directory (default: current directory)
  --roles CSV             Agent labels, excluding the operator (default: lead,worker,reviewer)
  --operator LABEL        Operator label (default: operator)
  --default-target LABEL  Default message target (default: first --roles label)
  --command COMMAND       Command launched in every pane (default: $SHELL or sh)
  --layout tiled|columns  Pane layout (default: tiled)
  --columns N             Columns layout width (default: 2 when layout is columns)
  --config PATH           Generated configuration path (default: ~/.commPact/config/team.conf)
  --replace-config        Back up and replace an existing generated configuration
  --config-only           Write the generated configuration but do not start tmux
  --attach                Attach to the new tmux session after setup
  --dry-run               Print the generated configuration without writing or starting tmux
  --help                  Show this help

Examples:
  commPact-setup
  commPact-setup --session project --roles driver,implementer,reviewer --command codex
USAGE
}

single_line() {
  [[ "$1" != *$'\n'* && "$1" != *$'\r'* ]]
}

csv_first() {
  local csv="$1"
  printf '%s' "${csv%%,*}"
}

csv_contains() {
  local wanted="$1" csv="$2" item
  local old_ifs="$IFS"
  IFS=','
  for item in $csv; do
    [[ "$item" == "$wanted" ]] && { IFS="$old_ifs"; return 0; }
  done
  IFS="$old_ifs"
  return 1
}

csv_unique() {
  local csv="$1" item prior seen=""
  local old_ifs="$IFS"
  IFS=','
  for item in $csv; do
    prior="$seen"
    if [[ ",$prior," == *",$item,"* ]]; then
      IFS="$old_ifs"
      return 1
    fi
    seen="${prior:+$prior,}$item"
  done
  IFS="$old_ifs"
  return 0
}

tmux_cmd() {
  if [[ -n "${COMMPACT_SOCKET:-}" ]]; then
    tmux -S "$COMMPACT_SOCKET" "$@"
  else
    tmux "$@"
  fi
}

check_setup_invocation() {
  [[ -n "${TMUX_PANE:-}" ]] || return 0
  local current_session current_agents current_operator current_label
  current_session="$(tmux_cmd display-message -p '#{session_name}' 2>/dev/null || true)"
  [[ -n "$current_session" ]] || return 0
  current_agents="$(tmux_cmd show-options -t "$current_session" -v @commPact_agent_roles 2>/dev/null || true)"
  [[ -n "$current_agents" ]] || return 0
  current_operator="$(tmux_cmd show-options -t "$current_session" -v @commPact_operator_role 2>/dev/null || true)"
  [[ -n "$current_operator" ]] || die "current commPact session metadata is incomplete; run setup from a normal shell or repair the session first"
  current_label="$(tmux_cmd display-message -p '#{@name}' 2>/dev/null || true)"
  [[ "$current_label" == "$current_operator" ]] \
    || die "setup is operator-only from an existing commPact session; run it from a normal shell or that session's operator pane"
}

config_body() {
  local role
  cat <<EOF
# Generated by commPact-setup. Edit later only if you need advanced options.
version=1
session=$session
workdir=$workdir
layout=$layout
EOF
  if [[ "$layout" == "columns" ]]; then
    printf 'columns=%s\n' "$columns"
  fi
  cat <<EOF
operator=$operator
default_target=$default_target
agent_roles=$roles
role=$operator|$command
EOF
  local old_ifs="$IFS"
  IFS=','
  for role in $roles; do
    printf 'role=%s|%s\n' "$role" "$command"
  done
  IFS="$old_ifs"
}

main() {
  local session="commpact"
  local workdir="$(pwd -P)"
  local roles="lead,worker,reviewer"
  local operator="operator"
  local default_target=""
  local command="${SHELL:-sh}"
  local layout="tiled"
  local columns=""
  local config_path="${HOME:?HOME is required}/.commPact/config/team.conf"
  local replace_config=false config_only=false attach=false dry_run=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --session) [[ $# -ge 2 ]] || die "--session requires a name"; session="$2"; shift 2 ;;
      --workdir) [[ $# -ge 2 ]] || die "--workdir requires a path"; workdir="$2"; shift 2 ;;
      --roles) [[ $# -ge 2 ]] || die "--roles requires comma-separated labels"; roles="$2"; shift 2 ;;
      --operator) [[ $# -ge 2 ]] || die "--operator requires a label"; operator="$2"; shift 2 ;;
      --default-target) [[ $# -ge 2 ]] || die "--default-target requires a label"; default_target="$2"; shift 2 ;;
      --command) [[ $# -ge 2 ]] || die "--command requires a command"; command="$2"; shift 2 ;;
      --layout) [[ $# -ge 2 ]] || die "--layout requires tiled or columns"; layout="$2"; shift 2 ;;
      --columns) [[ $# -ge 2 ]] || die "--columns requires a positive integer"; columns="$2"; shift 2 ;;
      --config) [[ $# -ge 2 ]] || die "--config requires a path"; config_path="$2"; shift 2 ;;
      --replace-config) replace_config=true; shift ;;
      --config-only) config_only=true; shift ;;
      --attach) attach=true; shift ;;
      --dry-run) dry_run=true; shift ;;
      --help|-h) usage; return 0 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  single_line "$session" && single_line "$workdir" && single_line "$command" && single_line "$config_path" \
    || die "session, workdir, command, and config path must be single-line values"
  [[ -n "$session" ]] || die "session must not be empty"
  [[ -n "$command" ]] || die "command must not be empty"
  [[ -d "$workdir" ]] || die "workdir does not exist: $workdir"
  workdir="$(cd "$workdir" && pwd -P)"
  commPactConfigLabelValid "$operator" || die "invalid operator label '$operator'"
  commPactConfigCsvValid "$roles" || die "--roles must be comma-separated valid labels"
  csv_unique "$roles" || die "--roles contains a duplicate label"
  csv_contains "$operator" "$roles" && die "operator must not be included in --roles"
  if [[ -z "$default_target" ]]; then
    default_target="$(csv_first "$roles")"
  fi
  commPactConfigLabelValid "$default_target" || die "invalid default target '$default_target'"
  csv_contains "$default_target" "$roles" || die "default target must be one of --roles"
  case "$layout" in
    tiled) [[ -z "$columns" ]] || die "--columns is valid only with --layout columns" ;;
    columns)
      [[ -n "$columns" ]] || columns=2
      [[ "$columns" =~ ^[1-9][0-9]*$ ]] || die "--columns must be a positive integer" ;;
    *) die "--layout must be tiled or columns" ;;
  esac
  [[ "$config_only" != true || "$attach" != true ]] || die "--attach is not valid with --config-only"

  if [[ "$dry_run" == true ]]; then
    config_body
    return 0
  fi

  [[ "$config_only" == true ]] || check_setup_invocation
  [[ ! -e "$config_path" || "$replace_config" == true ]] \
    || die "config already exists: $config_path (use --replace-config or choose --config)"
  if [[ "$config_only" != true ]] && tmux_cmd has-session -t "$session" 2>/dev/null; then
    die "session already exists: $session"
  fi

  local config_dir temp backup=""
  config_dir="$(dirname "$config_path")"
  mkdir -p "$config_dir"
  temp="$(mktemp "$config_dir/.commPact-team.XXXXXX")"
  cleanup_temp() { [[ -e "${temp:-}" ]] && rm -f -- "$temp"; }
  trap cleanup_temp EXIT
  umask 077
  config_body > "$temp"
  bash "$SCRIPT_DIR/../lib/commPact-config.sh" "$temp" >/dev/null
  if [[ -e "$config_path" ]]; then
    backup="${config_path}.backup.$(date '+%Y%m%d-%H%M%S')"
    cp -p "$config_path" "$backup"
  fi
  mv "$temp" "$config_path"
  trap - EXIT

  if [[ "$config_only" == true ]]; then
    echo "config created: $config_path"
    [[ -z "$backup" ]] || echo "previous config retained: $backup"
    echo "next: $SCRIPT_DIR/commPact-adopt --config $config_path --session $session --map ROLE=%PANE"
    return 0
  fi

  local -a init_args=(--config "$config_path")
  [[ "$attach" == true ]] && init_args+=(--attach)
  "$SCRIPT_DIR/commPact-init" "${init_args[@]}"
  echo "config created: $config_path"
  [[ -z "$backup" ]] || echo "previous config retained: $backup"
  echo "attach: tmux attach -t $session"
  echo "inspect panes: $SCRIPT_DIR/commPact list"
}

main "$@"
